/* ===== PALETA DE COLORES CAMUFLAJE ===== */
:root {
  --fondo-oscuro: #1F241D;
  --verde-oliva: #3B4235;
  --verde-medio: #555D4C;
  --verde-claro: #8C8D75;
  --beige: #C8C4B7;
  --marron: #604439;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background-color: var(--fondo-oscuro);
  /* Patrón sutil de camuflaje con gradientes */
  background-image: 
    radial-gradient(circle at 15% 25%, var(--verde-oliva) 0%, transparent 28%),
    radial-gradient(circle at 85% 75%, var(--verde-medio) 0%, transparent 32%),
    radial-gradient(circle at 50% 50%, var(--marron) 0%, transparent 38%);
  background-attachment: fixed;
  color: var(--beige);
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  line-height: 1.6;
  min-height: 100vh;
  padding: 2rem 1rem;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.contenedor {
  max-width: 820px;
  width: 100%;
}

/* ===== ENCABEZADO ===== */
header {
  text-align: center;
  margin-bottom: 3rem;
  padding-bottom: 1.5rem;
  border-bottom: 2px solid var(--verde-claro);
}

h1 {
  font-size: 2.2rem;
  letter-spacing: 1.5px;
  color: var(--beige);
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.6);
  margin-bottom: 0.5rem;
}

.subtitulo {
  font-size: 1.1rem;
  color: var(--verde-claro);
  font-style: italic;
  font-weight: 400;
}

/* ===== SECCIONES ===== */
section {
  margin-bottom: 2.5rem;
}

h2 {
  font-size: 1.4rem;
  color: var(--verde-claro);
  text-transform: uppercase;
  letter-spacing: 1.2px;
  margin-bottom: 1rem;
  padding-left: 0.5rem;
  border-left: 4px solid var(--marron);
}

/* ===== ACORDEÓN (BOTONES DESPLEGABLES) ===== */
details {
  margin-bottom: 0.75rem;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 3px 8px rgba(0, 0, 0, 0.4);
}

summary {
  display: block;
  background: linear-gradient(135deg, var(--verde-oliva), var(--verde-medio));
  color: var(--beige);
  padding: 1rem 1.2rem;
  font-size: 1.05rem;
  font-weight: 600;
  cursor: pointer;
  border: 1px solid rgba(200, 196, 183, 0.15);
  border-radius: 8px;
  list-style: none; /* Quita el triángulo por defecto */
  transition: background 0.3s ease, transform 0.1s ease;
  position: relative;
  user-select: none;
}

/* Quita la flecha por defecto en navegadores WebKit */
summary::-webkit-details-marker {
  display: none;
}

/* Icono de flecha personalizado */
summary::after {
  content: '▸';
  position: absolute;
  right: 1.2rem;
  transition: transform 0.3s ease;
  color: var(--verde-claro);
  font-size: 1.2rem;
}

details[open] summary::after {
  transform: rotate(90deg);
  color: var(--fondo-oscuro);
}

summary:hover {
  background: linear-gradient(135deg, var(--verde-medio), var(--verde-claro));
}

/* Estado abierto: botón resaltado */
details[open] summary {
  background: var(--verde-claro);
  color: var(--fondo-oscuro);
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
}

/* ===== CONTENIDO DESPLEGADO ===== */
.contenido-habilidad {
  background-color: rgba(59, 66, 53, 0.85); /* Verde oliva con transparencia */
  padding: 1rem 1.2rem;
  border-left: 3px solid var(--marron);
  border-bottom-left-radius: 8px;
  border-bottom-right-radius: 8px;
  color: var(--beige);
  font-size: 0.98rem;
  line-height: 1.5;
  animation: fadeIn 0.35s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-5px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ===== PIE DE PÁGINA ===== */
footer {
  margin-top: auto;
  padding-top: 2rem;
  text-align: center;
  font-size: 0.9rem;
  color: var(--verde-claro);
  border-top: 1px solid var(--verde-oliva);
  width: 100%;
  max-width: 820px;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 500px) {
  h1 { font-size: 1.6rem; }
  .subtitulo { font-size: 0.95rem; }
  h2 { font-size: 1.15rem; }
  summary { padding: 0.85rem 1rem; font-size: 0.95rem; }
}